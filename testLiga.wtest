import ligaDePilotos.*

describe "Grupo de test" {

  test "El vortex no puede volver a usarse luego de que se utilizó 3 veces consecutivas sin cargar la batería." {
    novaIshari.conducir(vortex)
    novaIshari.conducir(vortex)
    novaIshari.conducir(vortex)
    assert.notThat(vortex.tieneBateria())
  }

  test "Que en el modo intermedio un piloto obtiene 2 de experiencia al usar el Nebula ." {
    nebula.cambiarModo(intermedio)
    axelDraven.conducir(nebula)
    assert.equals(2, axelDraven.experiencia())
  }

  test "Que Kael Varela puede al inicio conducir el quantum." {
    assert.that(quantum.puedeUsarlo(kaelVarela))
  }

  test "Que Axel Draven solo puede hacer 5 pruebas con autos como máximo" {
    assert.that(quantum.puedeUsarlo(kaelVarela))
  }

}
